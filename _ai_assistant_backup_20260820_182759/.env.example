# # --- Database (Scenario 4) — Azure Synapse / SQL Server ---
# DB_HOST=averitassynprdwks.sql.azuresynapse.net
# DB_NAME=averitas_syn_prd_db
# DB_USER=your-db-username
# DB_PASSWORD=your-db-password
# DB_DRIVER={ODBC Driver 17 for SQL Server}
# DB_QUERY_TIMEOUT_SECONDS=30
# DB_MAX_ROWS=1000
# DB_LLM_FALLBACK_ENABLED=true

# # --- Chart Generation ---
# CHART_ENABLED=true
# CHART_OUTPUT_DIR=charts

# # --- Client ---
# API_BASE_URL=http://localhost:8000



# --- API Keys ---
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Model & Scenario Selection ---
ACTIVE_API_PROVIDER=groq              # groq | openai | anthropic
LLM_MODEL_NAME=llama-3.1-8b-instant
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ACTIVE_SCENARIO=4                     # 1=LLM only | 2=LLM+Rules | 3=Embedding+Rules | 4=Database

# --- LLM Generation Parameters ---
TEMPERATURE=0.7
MAX_TOKENS=1024
TOP_P=0.9
FREQUENCY_PENALTY=0.0
PRESENCE_PENALTY=0.0

# --- Memory & Cache ---
MEMORY_WINDOW_SIZE=15                 # 10–20 conversation turns
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
MAX_CACHE_ENTRIES=100

# --- Embedding Retrieval ---
EMBEDDING_DIMENSION=384
COSINE_SIMILARITY_THRESHOLD=0.70
TOP_K_RETRIEVAL=5

# --- Rule-Based Model ---
RULE_CONFIDENCE_THRESHOLD=0.80
RULE_MAX_MATCHES=3

# --- JWT Authentication ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Admin Credentials ---
# ADMIN_PASSWORD accepts either a bcrypt hash (recommended) or plaintext.
# Generate a hash:
# python -m auth.password mySecretPassword
#
# Example hash:
# $2b$12$KIXxPfFp6L6KAfNyc.Gk3uHWG6.Z6tt3J9aFq4yYNHkkbB0Hf5cKO

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Pinecone Vector Store ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=datastream-kb
PINECONE_CLOUD=aws                    # aws | gcp | azure
PINECONE_REGION=us-east-1

# --- Database (Scenario 4) — Azure Synapse / SQL Server ---
DB_HOST=averitassynprdwks.sql.azuresynapse.net
DB_NAME=averitas_syn_prd_db
DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_QUERY_TIMEOUT_SECONDS=30
DB_MAX_ROWS=1000
DB_LLM_FALLBACK_ENABLED=true

# --- Chart Generation ---
CHART_ENABLED=true
CHART_OUTPUT_DIR=charts

# --- Client ---
API_BASE_URL=http://localhost:8000