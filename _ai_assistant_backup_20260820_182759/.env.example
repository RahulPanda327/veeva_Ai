# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=24

# # --- Server ---
# APP_HOST=0.0.0.0
# APP_PORT=8000

# # --- Admin Credentials ---
# # ADMIN_PASSWORD accepts either a bcrypt hash (recommended) or plaintext.
# # Generate a hash:  python -m auth.password mySecretPassword
# # Example hash:     $2b$12$KIXxPfFp6L6KAfNyc.Gk3uHWG6.Z6tt3J9aFq4yYNHkkbB0Hf5cKO
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin

